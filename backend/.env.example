# Backend environment
LOG_LEVEL=INFO
LOG_FILE=./logs/semiml.log

# Storage paths
UPLOAD_DIR=./uploads
MODELS_DIR=./models
FAISS_INDEX_PATH=./faiss_index
DATABASE_URL=sqlite:///./decisions.db

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=semiml-experiments
MLFLOW_ENABLED=true

# LLM / LangChain Configuration
# Primary provider: gemini or groq or openai
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# Gemini Configuration
LLM_MODEL_GEMINI=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Configuration
LLM_MODEL_GROQ=llama3-8b-8192
GROQ_API_KEY=your_groq_api_key_here

# OpenAI Configuration (optional fallback)
LLM_MODEL_OPENAI=gpt-3.5-turbo
OPENAI_API_KEY=your_openai_api_key_here

# LangChain & RAG Configuration
KNOWLEDGE_BASE_PATH=./knowledge_base
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Validation thresholds
MIN_CROSS_VAL_SCORE=0.7
MAX_OVERFITTING_THRESHOLD=0.15

# Monitoring
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
